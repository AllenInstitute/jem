{
    "type": "object",
    "title":"JSON Electrophysiology Metadata (JEM) - HCT",
    "properties": {
        "formVersion": {
            "type":"string",
            "title":"Version",
            "readonly":true
        },
        "rigOperator": {
            "type": "string",
            "title": "Researcher",
            "enum":["davidm", "kristab", "sammyl","jonathant", "briank", "cristinar", "scotts", "nikd", "alejandrob"],
            "required":true
        },
        "rigNumber": {
            "type":"string",
            "title":"Rig #",
            "enum":["HCT1", "HCT2", "HCT3", "HCT4", "HCT5", "MP4", "HCTUW", "HCTUW2"],
            "required":true
        },
        "internalFillDate":{
            "format":"date",
            "title":"Internal Fill Date",
            "enum":["2026-08-26", "2026-07-02", "2026-05-19", "2026-04-02", "2026-02-09", "2026-01-05", "2025-11-12", "2025-09-19", "2025-07-28", "2025-06-13", "2025-04-29", "2025-03-13", "2025-03-03", "2025-01-31", "2024-12-12", "20204-09-17", "2024-07-19", "2024-06-07", "2024-04-23", "2024-01-22", "2023-10-20", "2023-07-19", "2023-06-07", "2023-04-20", "2023-03-06", "2023-01-31"],
            "required": true
        },
        "date":{
            "format":"date",
            "title":"Slice on Rig Date/Time",
            "required":true
        },
        "limsSpecName": {
            "type": "string",
            "title":"Slice ID",
            "required":true
        },
        "pipettes":{
            "type":"array",
            "items":{
                "title":"Patch-Seq Pipette",
                "type":"object",
                "properties":{
                    "status":{
                        "type":"string",
                        "title":"Was recording successful?",
                        "enum":["SUCCESS", "FAILURE"],
                        "default": ["SUCCESS"],
                        "required":true
                    },
                    "pipetteSpecName": {
                        "type": "string",
                        "title":"Pipette Specimen ID",
                        "required":false
                    },
                    "extraction":{
                        "type":"object",
                        "title":"Extraction Info",
                        "dependencies":"status",
                        "properties":{
                            "blankFillDate":{
                                "format":"date",
                                "title":"Blank Fill Date",
                                "enum":["2026-06-10", "2026-05-26", "2026-03-27", "2026-03-13", "2026-01-07","2025-12-10", "2025-08-27", "2025-07-30", "2025-06-25", "2025-05-02", "2025-02-06", "2025-01-09", "2024-11-07", "2024-09-11", "2024-07-18", "2024-06-20", "2024-05-22", "2024-05-01", "2024-04-25", "2024-03-27", "2024-02-22", "2024-01-04"],
                                "default": [],
                                "required": true
                            },
                            "tubeID":{
                                "type":"string",
                                "title":"Patched Cell Container",
                                "required":true
                            },
                            "postPatch":{
                                "type":"string",
                                "title":"Post Patch State",
                                "enum":["nucleus_present", "nucleus_absent", "entire_cell", "unknown"],
                                "default":[],
                                "required":true
                            }
                        }
                    },
                    "autoRoi":{
                        "type":"string",
                        "title": "ROI (Pinning Tool)",
                        "required":false,
                        "default":"None"
                    },
                    "manualRoi":{
                        "type":"string",
                        "title": "ROI",
                        "required":true
                    }
                }
            }
        }
    }
}